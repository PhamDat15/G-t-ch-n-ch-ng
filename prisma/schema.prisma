generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  REPORTER
}

enum ArticleStatus {
  DRAFT
  PENDING
  PUBLISHED
  REJECTED
}

model User {
  id        String    @id @default(cuid())
  username  String    @unique
  password  String
  fullName  String
  role      Role      @default(REPORTER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  articles  Article[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]
}

model Article {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  sapo         String
  content      String        // HTML formatted content with images and captions
  thumbnail    String?       // URL to high-res thumbnail
  author       String        @default("Ban Biên Tập")
  source       String?       // Nguồn tin / Gạt chân chống
  isFeatured   Boolean       @default(false)
  isHero       Boolean       @default(false) // Bài tiêu điểm lớn nhất trang chủ
  status       ArticleStatus @default(PUBLISHED)
  viewCount    Int           @default(0)
  readingTime  Int           @default(3)     // Số phút đọc
  publishedAt  DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  authorId     String?
  authorUser   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tags         Tag[]
  comments     Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  author    String
  email     String?
  content   String
  createdAt DateTime @default(now())

  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Tag {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  articles  Article[]
}

model SiteSettings {
  id              String   @id @default("main")
  siteName        String   @default("Tạp chí Việt Nam Travel")
  slogan          String   @default("Chạm tinh hoa, thưởng di sản")
  description     String   @default("Tạp chí điện tử về du lịch, văn hóa và di sản Việt Nam")
  editor          String   @default("Ban Biên tập Việt Nam Travel")
  address         String   @default("Hà Nội, Việt Nam")
  phone           String   @default("0988.123.456")
  email           String   @default("toasoan@vietnamtravel.vn")
  facebookUrl     String?
  youtubeUrl      String?
  tiktokUrl       String?
  instagramUrl    String?
  flightSearchUrl String   @default("https://www.google.com/travel/flights")
  updatedAt       DateTime @updatedAt
}
